<?xml version="1.0" encoding="utf-8" ?>
<!-- Run the custom action on the .NET Framework 4.x that ships with Windows 10 and 11. Without this, the packer asks for an older runtime. -->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
