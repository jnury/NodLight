<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    Per-user MSI (no admin rights): installs under %LocalAppData%\Programs\NodLight.
    It packages a published folder, so publish first:

      dotnet publish src/NodLight.App -c Release -r win-x64 -p:SelfContained=false -o artifacts/publish
      dotnet build installer -c Release -p:Version=1.2.3 -p:PublishDir=<absolute path of the publish folder>
  -->
  <PropertyGroup>
    <OutputName>NodLight</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish</PublishDir>
    <DefineConstants>$(DefineConstants);Version=$(Version);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)'))</DefineConstants>
    <!-- Dual-purpose package: components are per-user or per-machine depending on the chosen context, so the per-user
         checks that assume one fixed context (ICE38, ICE57, ICE64, ICE91) do not apply. ICE105 still checks the package. -->
    <SuppressIces>ICE38;ICE57;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <Target Name="CheckPublishDir" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PublishDir)\NodLight.exe')"
           Text="PublishDir '$(PublishDir)' has no NodLight.exe. Publish the app first and pass an absolute -p:PublishDir." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="CheckDotNet\CheckDotNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="$(PublishDir)">
      <ComponentGroupName>AppFiles</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <PreprocessorVariable>var.PublishDir</PreprocessorVariable>
    </HarvestDirectory>
  </ItemGroup>

</Project>
