<Application x:Class="NodLight.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- 12x12 line icons, drawn as geometry so they take the surrounding text colour and need no icon font.
             Shared by the strip's cards and the taskbar thumbnail. -->
        <Geometry x:Key="CpuIcon">M3,3 H9 V9 H3 Z M5,1 V3 M7,1 V3 M5,9 V11 M7,9 V11 M1,5 H3 M1,7 H3 M9,5 H11 M9,7 H11</Geometry>
        <Geometry x:Key="MemoryIcon">M1,3 H11 V8 H1 Z M3,5 V6.5 M5,5 V6.5 M7,5 V6.5 M9,5 V6.5 M2.5,8 V10 M5,8 V10 M7,8 V10 M9.5,8 V10</Geometry>
        <Geometry x:Key="IoIcon">M4,10.5 V1.5 M1.5,4 L4,1.5 L6.5,4 M8,1.5 V10.5 M5.5,8 L8,10.5 L10.5,8</Geometry>
    </Application.Resources>
</Application>
