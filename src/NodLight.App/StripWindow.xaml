<Window x:Class="NodLight.App.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NodLight.App"
        xmlns:core="clr-namespace:NodLight.Core;assembly=NodLight.Core"
        Title="NodLight"
        Width="240"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Header buttons: flat, themed, accent-tinted on hover. -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="9,2,9,2" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One usage figure (icon + value): muted, warning colour when its metric is high. -->
        <Style x:Key="UsageCell" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource EdgeBrush}"
            BorderThickness="1,1,0,0"
            CornerRadius="8,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource HeaderBrush}" CornerRadius="7,0,0,0" Padding="10,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NodLight"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+"
                                Click="NewSession_Click"
                                ToolTip="New Alacritty window"
                                Style="{StaticResource HeaderButton}"
                                Width="24"
                                Margin="0,0,5,0"
                                Padding="0,0,0,1"
                                FontSize="14"
                                FontWeight="SemiBold" />
                        <Button Content="Hide"
                                Click="Hide_Click"
                                Style="{StaticResource HeaderButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Cards}" Margin="6,6,6,1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CardViewModel}">
                            <Border Margin="0,0,0,5"
                                    Padding="7,6,7,6"
                                    CornerRadius="4"
                                    BorderThickness="3,0,0,0"
                                    Cursor="Hand"
                                    ToolTip="{Binding ToolTip}"
                                    MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource IdleBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:SessionStatus.Working}">
                                                <Setter Property="BorderBrush" Value="{DynamicResource WorkingBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:SessionStatus.Waiting}">
                                                <Setter Property="BorderBrush" Value="{DynamicResource WaitingBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource CardWaitingBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Blink">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.55"
                                                                             Duration="0:0:0.9"
                                                                             AutoReverse="True"
                                                                             RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="Blink" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static core:SessionStatus.Idle}">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Grid.Column="1"
                                                Margin="5,0,0,0"
                                                Padding="4,0,4,1"
                                                CornerRadius="3"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource BadgeBrush}">
                                            <TextBlock Text="{Binding AgentBadge}" Foreground="{DynamicResource BadgeTextBrush}" FontSize="10" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding StatusLine}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,2,0,0" ToolTip="{Binding UsageToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel" BasedOn="{StaticResource UsageCell}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CpuHigh}" Value="True">
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource HighUsageBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Path Data="{StaticResource CpuIcon}" Width="12" Height="12" Margin="0,0,4,0"
                                                  Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                  StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  ToolTip="CPU" />
                                            <TextBlock Text="{Binding CpuText}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel" BasedOn="{StaticResource UsageCell}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MemoryHigh}" Value="True">
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource HighUsageBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Path Data="{StaticResource MemoryIcon}" Width="12" Height="12" Margin="0,0,4,0"
                                                  Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                  StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  ToolTip="Memory" />
                                            <TextBlock Text="{Binding MemoryText}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel" BasedOn="{StaticResource UsageCell}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IoHigh}" Value="True">
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource HighUsageBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Path Data="{StaticResource IoIcon}" Width="12" Height="12" Margin="0,0,4,0"
                                                  Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                  StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  ToolTip="Disk and network I/O" />
                                            <TextBlock Text="{Binding IoText}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
